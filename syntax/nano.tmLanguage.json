{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nano",
  "scopeName": "source.nano",
  "fileTypes": ["nano"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#properties" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.number-sign.nano", "match": "#.*$" },
      ]
    },
    "strings": {
      "name": "string.quoted.double.nano",
      "begin": """,
      "end": """,
      "patterns": [
        { "name": "constant.character.escape.nano", "match": "\\\\(?:n|r|t|\\|\")" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.nano", "match": "\\b(?:[0-9]+\\.[0-9]*|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?\\b" },
        { "name": "constant.numeric.integer.nano", "match": "\\b[0-9]+\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.nano", "match": "\\b(?:if|else|while|for|in|return|use)\\b" },
        { "name": "storage.type.function.nano", "match": "\\bfunction\\b" },
        { "name": "keyword.other.print.nano", "match": "\\bprint\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.boolean.nano", "match": "\\b(?:true|false)\\b" }
      ]
    },
    "builtins": {
      "patterns": [
        { "name": "support.function.builtin.nano", "match": "\\b(?:len|range|to_text|to_number|upper|lower|trim|contains|starts_with|ends_with|replace|substring|char_at|split|join|append|tensor|parameter|zeros|shape|matmul|sum|mean|grad|step|adam|backend|device|dtype|memory_bytes|cast|fs_read_text|fs_write_text|fs_append_text|fs_exists|fs_list|fs_mkdir|fs_remove|env_get|env_set|process_spawn|process_wait|time_now_ms|time_sleep_ms|thread_sleep_ms|thread_spawn|thread_join|net_tcp_connect|net_tcp_listen|net_tcp_accept|net_tcp_send|net_tcp_recv|net_tcp_close|ui_window|ui_set_title|ui_close|ui_poll_event)\\b(?=\\s*\\()" }
      ]
    },
    "functions": {
      "patterns": [
        { "name": "entity.name.function.definition.nano", "match": "(?<=\\bfunction\\s)[A-Za-z_][A-Za-z0-9_]*" },
        { "name": "entity.name.function.call.nano", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.nano", "match": "==|!=|>=|<=|&&|\\|\\||[+*/%<>=!-]" }
      ]
    },
    "properties": {
      "patterns": [
        { "name": "variable.other.property.nano", "match": "\\.[A-Za-z_][A-Za-z0-9_]*" },
        { "name": "variable.other.nano", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b" }
      ]
    }
  }
}

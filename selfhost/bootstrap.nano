# Nano self-host bootstrap.
# O bootstrap usa o runtime Nano para carregar lexer, parser e compiler
# e produzir o IR textual do próprio compilador.

use "selfhost/lexer.nano"
use "selfhost/parser.nano"
use "selfhost/semantic.nano"
use "selfhost/compiler.nano"
use "selfhost/c_backend.nano"

function compile_file(path) {
    tokens = lex(path)
    ast = parse_program(tokens)

    if !ast.ok {
        return {ok: false, stage: "parser", error: ast.error, ir: ""}
    }

    semantic = validate_program(ast.node)
    if !semantic.ok {
        return {ok: false, stage: "semantic", error: semantic.error, ir: ""}
    }

    ir = emit_program(ast.node)
    return {ok: true, stage: "compiler", error: "", ir: join(ir, "\n")}
}

function main() {
    input = std.env.get("NANO_SELFHOST_INPUT")
    if input == null {
        input = "examples/main.nano"
    }
    result = compile_file(input)

    if result.ok {
        c_destination = std.env.get("NANO_SELFHOST_C")
        if c_destination != null {
            runtime_path = std.env.get("NANO_SELFHOST_RUNTIME")
            if runtime_path == null {
                runtime_path = "src/native_runtime.c"
            }
            runtime_text = std.fs.read_text(runtime_path)
            generated = emit_c(result.ir, runtime_text)
            if generated.ok {
                std.fs.write_text(c_destination, generated.c)
                print "self-host C OK"
            } else {
                print "c_backend: " + generated.error
            }
        } else {
            destination = std.env.get("NANO_SELFHOST_OUTPUT")
            if destination != null {
                std.fs.write_text(destination, result.ir)
            } else {
                print result.ir
            }
        }
    } else {
        print result.stage + ": " + result.error
    }
}

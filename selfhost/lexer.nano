# Nano self-hosted lexer v0.1

function is_space(c) {
    return contains(" \n\r\t", c)
}

function is_alpha(c) {
    return contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c)
}

function is_digit(c) {
    return contains("0123456789", c)
}

function is_alnum(c) {
    return contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789", c)
}

function lex(path) {
    source = fs_read_text(path)
    tokens = []
    i = 0
    n = len(source)

    while i < n {
        c = char_at(source, i)

        if is_space(c) {
            i = i + 1
        } else if c == "#" {
            i = i + 1
            while i < n {
                c = char_at(source, i)
                if c == "\n" {
                    i = n
                } else {
                    i = i + 1
                }
            }
        } else if is_alpha(c) {
            start = i
            j = i + 1
            end = j
            while j < n {
                c = char_at(source, j)
                if is_alnum(c) {
                    j = j + 1
                    end = j
                } else {
                    j = n
                }
            }
            i = end
            tokens = append(tokens, {kind: "ident", text: substring(source, start, i)})
        } else if is_digit(c) {
            start = i
            j = i + 1
            end = j
            while j < n {
                c = char_at(source, j)
                if is_digit(c) {
                    j = j + 1
                    end = j
                } else if c == "." {
                    j = j + 1
                    end = j
                } else {
                    j = n
                }
            }
            i = end
            tokens = append(tokens, {kind: "number", text: substring(source, start, i)})
        } else if c == "\"" {
            start = i + 1
            i = i + 1
            j = i
            end = i
            while j < n {
                c = char_at(source, j)
                if c == "\"" {
                    end = j
                    j = n
                } else {
                    j = j + 1
                    end = j
                }
            }
            i = end + 1
            tokens = append(tokens, {kind: "string", text: substring(source, start, end)})
        } else {
            tokens = append(tokens, {kind: "symbol", text: c})
            i = i + 1
        }
    }

    return tokens
}

function main() {
    tokens = lex("main.nano")
    print join(tokens, "\n")
}

# Nano self-hosted lexer v0.1

function is_space(c) {
    return contains(" \n\r\t", c)
}

function is_alpha(c) {
    return contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c)
}

function is_digit(c) {
    return contains("0123456789", c)
}

function is_alnum(c) {
    return contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789", c)
}

function lex(path) {
    source = fs_read_text(path)
    tokens = []
    i = 0
    n = len(source)

    while i < n {
        c = char_at(source, i)

        if is_space(c) {
            i = i + 1
        } else if c == "#" {
            i = i + 1
            while i < n && char_at(source, i) != "\n" {
                i = i + 1
            }
        } else if c == "\"" {
            value = ""
            i = i + 1
            closed = false
            while i < n {
                c = char_at(source, i)
                if c == "\"" {
                    i = i + 1
                    closed = true
                    break
                } else if c == "\\" {
                    i = i + 1
                    if i >= n {
                        return []
                    }
                    e = char_at(source, i)
                    if e == "n" {
                        value = value + "\n"
                    } else if e == "r" {
                        value = value + "\r"
                    } else if e == "t" {
                        value = value + "\t"
                    } else if e == "\"" {
                        value = value + "\""
                    } else if e == "\\" {
                        value = value + "\\"
                    } else {
                        value = value + e
                    }
                    i = i + 1
                } else {
                    value = value + c
                    i = i + 1
                }
            }
            if closed {
                tokens = append(tokens, {kind: "string", text: value})
            }
        } else if is_alpha(c) {
            start_index = i
            i = i + 1
            while i < n && is_alnum(char_at(source, i)) {
                i = i + 1
            }
            tokens = append(tokens, {kind: "ident", text: substring(source, start_index, i)})
        } else if is_digit(c) {
            start_index = i
            dot_seen = false
            done = false
            i = i + 1
            while i < n && !done {
                c = char_at(source, i)
                if is_digit(c) {
                    i = i + 1
                } else if c == "." && !dot_seen {
                    dot_seen = true
                    i = i + 1
                } else {
                    done = true
                }
            }
            tokens = append(tokens, {kind: "number", text: substring(source, start_index, i)})
        } else if i + 1 < n && (
            (c == "=" && char_at(source, i + 1) == "=") ||
            (c == "!" && char_at(source, i + 1) == "=") ||
            (c == ">" && char_at(source, i + 1) == "=") ||
            (c == "<" && char_at(source, i + 1) == "=") ||
            (c == "&" && char_at(source, i + 1) == "&") ||
            (c == "|" && char_at(source, i + 1) == "|")
        ) {
            tokens = append(tokens, {kind: "symbol", text: substring(source, i, i + 2)})
            i = i + 2
        } else {
            tokens = append(tokens, {kind: "symbol", text: c})
            i = i + 1
        }
    }

    return tokens
}

function main() {
    tokens = lex("main.nano")
    print join(tokens, "\n")
}

# Nano self-hosted compiler v0.2
# AST -> Nano IR textual.
# O formato emitido é determinístico e mantém funções separadas do _main.

function escape_text(value) {
    value = replace(value, "\\", "\\\\")
    value = replace(value, "\"", "\\\"")
    value = replace(value, "
", "\\n")
    value = replace(value, "", "\\r")
    value = replace(value, "	", "\\t")
    return value
}

function qualified_name(node) {
    if node.kind == "ident" {
        return node.name
    }

    if node.kind == "field" {
        base = qualified_name(node.target)
        if base != "" {
            return base + "." + node.name
        }
    }

    return ""
}

function emit_expr(node) {
    lines = []

    if node.kind == "number" {
        return append(lines, "const " + to_text(node.value))
    }

    if node.kind == "string" {
        return append(lines, "const \"" + escape_text(node.value) + "\"")
    }

    if node.kind == "boolean" {
        return append(lines, "const " + to_text(node.value))
    }

    if node.kind == "null" {
        return append(lines, "const null")
    }

    if node.kind == "ident" {
        return append(lines, "load " + node.name)
    }

    if node.kind == "unary" {
        lines = emit_expr(node.value)
        return append(lines, "unary " + node.op)
    }

    if node.kind == "binary" {
        lines = emit_expr(node.left)
        right = emit_expr(node.right)
        for line in right {
            lines = append(lines, line)
        }
        return append(lines, "binary " + node.op)
    }

    if node.kind == "call" {
        name = qualified_name(node.target)
        if name != "" {
            for arg in node.args {
                part = emit_expr(arg)
                for line in part {
                    lines = append(lines, line)
                }
            }
            return append(lines, "call " + name + " " + to_text(len(node.args)))
        }

        target = emit_expr(node.target)
        for line in target {
            lines = append(lines, line)
        }
        for arg in node.args {
            part = emit_expr(arg)
            for line in part {
                lines = append(lines, line)
            }
        }
        return append(lines, "call_value " + to_text(len(node.args)))
    }

    if node.kind == "list" {
        for item in node.items {
            part = emit_expr(item)
            for line in part {
                lines = append(lines, line)
            }
        }
        return append(lines, "make_list " + to_text(len(node.items)))
    }

    if node.kind == "object" {
        keys = []
        for field in node.fields {
            keys = append(keys, field.key)
            part = emit_expr(field.value)
            for line in part {
                lines = append(lines, line)
            }
        }

        key_text = join(keys, ",")
        if key_text == "" {
            return append(lines, "make_object")
        }
        return append(lines, "make_object " + key_text)
    }

    if node.kind == "index" {
        lines = emit_expr(node.target)
        part = emit_expr(node.index)
        for line in part {
            lines = append(lines, line)
        }
        return append(lines, "index")
    }

    if node.kind == "field" {
        lines = emit_expr(node.target)
        return append(lines, "field " + node.name)
    }

    return append(lines, "unsupported " + node.kind)
}

function emit_block(body, counter) {
    lines = []
    next_counter = counter

    for stmt in body {
        part = emit_stmt(stmt, next_counter)
        for line in part.lines {
            lines = append(lines, line)
        }
        next_counter = part.next
    }

    return {lines: lines, next: next_counter}
}

function emit_function(stmt, counter) {
    lines = []

    signature = "function " + stmt.name + "(" + join(stmt.params, ", ") + ")"
    lines = append(lines, signature)

    body = emit_block(stmt.body.body, counter)
    for line in body.lines {
        lines = append(lines, line)
    }

    lines = append(lines, "end_function")
    return {lines: lines, next: body.next}
}

function emit_stmt(stmt, counter) {
    lines = []

    if stmt.kind == "assign" {
        lines = emit_expr(stmt.value)
        return {lines: append(lines, "store " + stmt.name), next: counter}
    }

    if stmt.kind == "assign_index" {
        lines = emit_expr(stmt.target)
        index = emit_expr(stmt.index)
        value = emit_expr(stmt.value)
        for line in index {
            lines = append(lines, line)
        }
        for line in value {
            lines = append(lines, line)
        }
        return {lines: append(lines, "set_index"), next: counter}
    }

    if stmt.kind == "assign_field" {
        lines = emit_expr(stmt.target)
        value = emit_expr(stmt.value)
        for line in value {
            lines = append(lines, line)
        }
        return {lines: append(lines, "set_field " + stmt.name), next: counter}
    }

    if stmt.kind == "expr" {
        lines = emit_expr(stmt.value)
        return {lines: append(lines, "pop"), next: counter}
    }

    if stmt.kind == "print" {
        lines = emit_expr(stmt.value)
        return {lines: append(lines, "print"), next: counter}
    }

    if stmt.kind == "return" {
        lines = emit_expr(stmt.value)
        return {lines: append(lines, "return"), next: counter}
    }

    if stmt.kind == "break" {
        return {lines: append(lines, "break"), next: counter}
    }

    if stmt.kind == "use" {
        return {lines: append(lines, "use " + stmt.path), next: counter}
    }

    if stmt.kind == "if" {
        condition = emit_expr(stmt.condition)
        for line in condition {
            lines = append(lines, line)
        }

        else_id = counter
        counter = counter + 1
        end_id = counter
        counter = counter + 1
        else_label = "L" + to_text(else_id)
        end_label = "L" + to_text(end_id)

        lines = append(lines, "jump_if_false " + else_label)

        yes = emit_block(stmt.yes.body, counter)
        for line in yes.lines {
            lines = append(lines, line)
        }
        counter = yes.next

        lines = append(lines, "jump " + end_label)
        lines = append(lines, "label " + else_label)

        no = emit_block(stmt.no.body, counter)
        for line in no.lines {
            lines = append(lines, line)
        }
        counter = no.next

        lines = append(lines, "label " + end_label)
        return {lines: lines, next: counter}
    }

    if stmt.kind == "while" {
        start_id = counter
        counter = counter + 1
        end_id = counter
        counter = counter + 1
        start_label = "L" + to_text(start_id)
        end_label = "L" + to_text(end_id)

        lines = append(lines, "label " + start_label)

        condition = emit_expr(stmt.condition)
        for line in condition {
            lines = append(lines, line)
        }
        lines = append(lines, "jump_if_false " + end_label)

        body = emit_block(stmt.body.body, counter)
        for line in body.lines {
            lines = append(lines, line)
        }
        counter = body.next

        lines = append(lines, "jump " + start_label)
        lines = append(lines, "label " + end_label)
        return {lines: lines, next: counter}
    }

    if stmt.kind == "for" {
        start_id = counter
        counter = counter + 1
        end_id = counter
        counter = counter + 1
        start_label = "L" + to_text(start_id)
        end_label = "L" + to_text(end_id)

        lines = emit_expr(stmt.iterable)
        lines = append(lines, "iter_init")
        lines = append(lines, "label " + start_label)
        lines = append(lines, "iter_next " + stmt.name + " " + end_label)

        body = emit_block(stmt.body.body, counter)
        for line in body.lines {
            lines = append(lines, line)
        }
        counter = body.next

        lines = append(lines, "jump " + start_label)
        lines = append(lines, "label " + end_label)
        return {lines: lines, next: counter}
    }

    return {lines: append(lines, "unsupported_stmt " + stmt.kind), next: counter}
}

function emit_program(program) {
    lines = []
    functions = []
    main_body = []

    for stmt in program.body {
        if stmt.kind == "function" {
            functions = append(functions, stmt)
        } else {
            main_body = append(main_body, stmt)
        }
    }

    counter = 0

    for function in functions {
        part = emit_function(function, counter)
        for line in part.lines {
            lines = append(lines, line)
        }
        counter = part.next
        lines = append(lines, "")
    }

    lines = append(lines, "function _main()")
    main = emit_block(main_body, counter)
    for line in main.lines {
        lines = append(lines, line)
    }
    lines = append(lines, "end_function")

    return lines
}

function main() {
    tokens = lex("main.nano")
    parsed = parse_program(tokens)

    if !parsed.ok {
        print "parse error: " + parsed.error
    } else {
        lines = emit_program(parsed.node)
        print join(lines, "\n")
    }
}

use "std.fs"

assert(2 + 3 == 5)
assert(upper("nano") == "NANO")
assert(pow(2, 8) == 256)

channel_id = std.async.channel()
std.async.send(channel_id, "ok")
message = std.async.recv(channel_id)
assert(message == "ok")
std.async.close_channel(channel_id)

path = "tests/.nano-test.tmp"
std.fs.write_text(path, "nano")
assert(std.fs.exists(path))
assert(std.fs.read_text(path) == "nano")
std.fs.remove(path)
assert(!std.fs.exists(path))

use "std.fs"

assert(2 + 3 == 5, "arithmetic")
assert(upper("nano") == "NANO", "upper")
assert(pow(2, 8) == 256, "pow")

channel_id = std.async.channel()
std.async.send(channel_id, "ok")
message = std.async.recv(channel_id)
assert(message == "ok", "channel-send")
std.async.close_channel(channel_id)

path = "tests/.nano-test.tmp"
std.fs.write_text(path, "nano")
assert(std.fs.exists(path), "fs-exists")
assert(std.fs.read_text(path) == "nano", "fs-read")
std.fs.remove(path)
assert(!std.fs.exists(path), "fs-remove-exists")

assert(std.math.pow(2, 8) == 256, "std-math-pow")
assert(std.env.get("NANO_UNSET_TEST") == null, "std-env-get-missing")

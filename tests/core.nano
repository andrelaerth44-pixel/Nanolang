use "std.fs"

assert(2 + 3 == 5, "arithmetic")
assert(upper("nano") == "NANO", "upper")
assert(pow(2, 8) == 256, "pow")

channel_id = std.async.channel()
std.async.send(channel_id, "ok")
message = std.async.recv(channel_id)
assert(message == "ok", "channel-send")
std.async.close_channel(channel_id)

path = "tests/.nano-test.tmp"
std.fs.write_text(path, "nano")
assert(std.fs.exists(path), "fs-exists")
assert(std.fs.is_file(path), "fs-is-file")
assert(!std.fs.is_dir(path), "fs-is-dir")
assert(std.path.basename(path) == ".nano-test.tmp", "path-basename")
assert(std.path.extension(path) == "tmp", "path-extension")
assert(std.path.dirname(std.path.join("tests", "sample.nano")) == "tests", "path-join-dirname")
assert(std.fs.read_text(path) == "nano", "fs-read")
std.fs.remove(path)
assert(!std.fs.exists(path), "fs-remove-exists")
assert(std.fs.cwd() != "", "fs-cwd")
assert(std.os.cwd() != "", "os-cwd")

process_result = std.process.output("printf", ["nano"])
assert(process_result.code == 0, "process-output-code")
assert(process_result.stdout == "nano", "process-output-stdout")

assert(std.math.pow(2, 8) == 256, "std-math-pow")
assert(std.env.get("NANO_UNSET_TEST") == null, "std-env-get-missing")
json_text = std.json.encode({name: "nano", values: [1, 2, true]})
json_value = std.json.decode(json_text)
assert(json_value.name == "nano", "json-object")
assert(json_value.values[2] == true, "json-array")

function square(value) {
    return value * value
}

task = task_spawn("square", [6])
task_result = task_join(task)
assert(task_result == 36, "task-concurrency")

function double(value) {
    return value * 2
}

function triple_double(value) {
    return double(value) + value
}

task2 = task_spawn("triple_double", [5])
assert(task_join(task2) == 15, "task-function-dependency")

two_arg = pow(2, 8)
assert(two_arg == 256, "call-argument-order")

text_value = replace("nano-lang", "-", "_")
assert(text_value == "nano_lang", "replace-argument-order")

tensor_value = tensor([1, 2, 3, 4], [2, 2])
assert(shape(tensor_value) == [2, 2], "tensor-argument-order")

function text_identity(value) {
    return value
}
assert(text_identity("nano") == "nano", "text-parameter")
